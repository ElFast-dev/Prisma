{
  "name": "prisma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test --config=playwright.pwa.config.ts",
    "test:e2e:report": "playwright show-report",
    "test:spectro:simulation": "vitest run src/domain/spectroSimulation.test.ts --reporter=verbose"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "@vite-pwa/workbox-window": "8.0.15"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.1",
    "@vite-pwa/workbox-build": "8.0.15",
    "magicast": "^0.5.0"
  }
}
